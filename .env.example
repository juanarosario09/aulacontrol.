# ──────────────────────────────────────────
#  AulaControl — Variables de entorno
#  Copia este archivo a .env.local y completa los valores
# ──────────────────────────────────────────

# Base de datos (PostgreSQL recomendado, o SQLite para desarrollo)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aulacontrol?schema=public"
# Para SQLite en desarrollo:
# DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-muy-largo-y-aleatorio"

# Resend (correo electrónico)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@tudominio.com"

# App
NEXT_PUBLIC_APP_NAME="AulaControl"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
